{
  "expo": {
    "name": "CropCheck",
    "slug": "cropcheck",
    "scheme": "cropcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.curvvtech.cropcheck"
    },
    "android": {
      "package": "com.curvvtech.cropcheck",
      "adaptiveIcon": {
        "backgroundColor": "#163E23",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F4F1EA"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CropCheck needs access to your photos so you can attach a picture of your produce to a listing.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
